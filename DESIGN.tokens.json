  "type": {
    "face": "ui-sans-serif, system-ui (no display face shipped)",
    "mono": "ui-monospace, Cascadia Code, monospace",
    "body": "14px / 1.45",
    "annotation": "9.5px / 0.07em / uppercase",
    "fieldLabel": "10px / 0.08em / uppercase / --muted",
    "figureRamp": ["30px/600", "22px/600", "13px/600", "12.5px"],
    "tabular": "font-variant-numeric: tabular-nums on all money; switched off only for .is-absent"
  },
  "namedRules": [
    "no depth, no glow, no gradient — enforced at the token layer",
    "colour is semantic only; order is carried by line weight",
    "no glyph sets its own colour; the row's state class paints currentColor",
    "a cap is a threshold, not an alarm, until the level approaches it",
    "absence states which absence it is, at the muted floor, tabular off",
    "unknown is hatched, never zeroed",
    "one prefix per surface; source order is the cascade"
  ],
  "openDefects": [
    "app/page.tsx:94 stat-tile grid contradicts the THESIS; delete, do not restyle",
    "no drawing frame, title block or registration marks",
    "float/workforce partly unconverted: 12-16px radii and pill forms",
    ".float-eyebrow and .workforce-eyebrow (6 call sites) are craft-floor refusals",
    "app/workforce/page.tsx:102 typographic glyph icons '▣' '⊘' '›_'",
    "27 hardcoded radii above 2px plus 29 pill/circle radii bypass --radius",
    "--muted-2 dark corrected to #918d85 (4.64 on --panel-3) during the finish review"
  ]
}
