#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
audit_source="$repo_root/scripts/a14-audit"
allow_source="$repo_root/scripts/a14-audit.allow"
inert_source="$repo_root/scripts/a14-audit.inert-blobs"
fixture_root="$(mktemp -d)"
trap 'rm -rf "$fixture_root"' EXIT

commit_fixture() {
  local target="$1" message="$2"
  git -c commit.gpgsign=false -c core.hooksPath=/dev/null -C "$target" \
    commit --no-verify -q -m "$message"
}

init_fixture() {
  local target="$1"
  mkdir -p "$target/scripts"
  git -C "$target" init -q
  git -C "$target" config user.name "A14 audit test"
  git -C "$target" config user.email "a14-audit@example.invalid"
  cp "$audit_source" "$target/scripts/a14-audit"
  cp "$allow_source" "$target/scripts/a14-audit.allow"
  cp "$inert_source" "$target/scripts/a14-audit.inert-blobs"
  chmod +x "$target/scripts/a14-audit"
}

failures=0
expect_failure() {
  local label="$1" target="$2" expected="$3" output
  if output="$(cd "$target" && ./scripts/a14-audit 2>&1)"; then
    echo "FAIL: $label unexpectedly passed"
    printf '%s\n' "$output"
    failures=$((failures + 1))
  elif [[ "$output" != *"$expected"* ]]; then
    echo "FAIL: $label did not report the expected reason: $expected"
    printf '%s\n' "$output"
    failures=$((failures + 1))
  fi
}

docs_repo="$fixture_root/documentation"
init_fixture "$docs_repo"
mkdir -p "$docs_repo/docs"
printf '# A14 audit evidence\n' >"$docs_repo/docs/A14-SECRET-INTEGRITY-AUDIT.md"
git -C "$docs_repo" add .
commit_fixture "$docs_repo" "Add audit documentation"
if ! docs_output="$(cd "$docs_repo" && ./scripts/a14-audit 2>&1)"; then
  echo "FAIL: the audit rejects its reviewed documentation allowlist"
  printf '%s\n' "$docs_output"
  failures=$((failures + 1))
fi

history_repo="$fixture_root/history"
init_fixture "$history_repo"
git -C "$history_repo" add .
commit_fixture "$history_repo" "Add audit command"
printf 'retired test credential: %s%s\n' 'AKIA' 'ABCDEFGHIJKLMNOP' >"$history_repo/retired.txt"
git -C "$history_repo" add retired.txt
commit_fixture "$history_repo" "Add credential fixture"
git -C "$history_repo" rm -q retired.txt
commit_fixture "$history_repo" "Remove credential fixture"
expect_failure \
  "reachable-history secret" "$history_repo" \
  "FAIL: high-confidence secret pattern(s) in reachable Git tree history:"

# A reviewed inert version is exempt in history only, and only for its exact blob and path.
write_userinfo_fixture() {
  printf 'const rpc = "%s%s";\n' 'https://fixture-user:' "$2@node.example/rpc" >"$1"
}
inert_repo="$fixture_root/inert-history"
init_fixture "$inert_repo"
mkdir -p "$inert_repo/lib"
write_userinfo_fixture "$inert_repo/lib/fixture.test.ts" 'inert-pass-one'
git -C "$inert_repo" add .
commit_fixture "$inert_repo" "Add literal userinfo fixture"
inert_blob="$(git -C "$inert_repo" rev-parse HEAD:lib/fixture.test.ts)"
printf '%s | lib/fixture.test.ts | Reviewed inert fixture.\n' "$inert_blob" >>"$inert_repo/scripts/a14-audit.inert-blobs"
# Still in the current tree: the exception must not apply.
git -C "$inert_repo" add .
commit_fixture "$inert_repo" "Review the fixture version"
expect_failure "inert version still in the current tree" "$inert_repo" "FAIL: high-confidence secret pattern(s) in the current tree:"
printf 'const rpc = "safe";\n' >"$inert_repo/lib/fixture.test.ts"
git -C "$inert_repo" add .
commit_fixture "$inert_repo" "Assemble the fixture at runtime"
if ! inert_output="$(cd "$inert_repo" && ./scripts/a14-audit 2>&1)"; then
  echo "FAIL: the audit rejects a reviewed inert history version"
  printf '%s\n' "$inert_output"
  failures=$((failures + 1))
elif [[ "$inert_output" != *"$inert_blob lib/fixture.test.ts"* ]]; then
  echo "FAIL: the audit did not report the inert history version it accepted"
  printf '%s\n' "$inert_output"
  failures=$((failures + 1))
fi
# A different version at the same path is not covered by the reviewed blob.
write_userinfo_fixture "$inert_repo/lib/fixture.test.ts" 'unreviewed-pass-two'
git -C "$inert_repo" add .
commit_fixture "$inert_repo" "Reintroduce a different literal"
printf 'const rpc = "safe again";\n' >"$inert_repo/lib/fixture.test.ts"
git -C "$inert_repo" add .
commit_fixture "$inert_repo" "Remove it again"
expect_failure "unreviewed version at a reviewed path" "$inert_repo" ":lib/fixture.test.ts"

# The same reviewed blob at another path is not covered either.
moved_repo="$fixture_root/inert-moved"
init_fixture "$moved_repo"
mkdir -p "$moved_repo/lib"
write_userinfo_fixture "$moved_repo/lib/other.test.ts" 'inert-pass-one'
moved_blob="$(git -C "$moved_repo" hash-object lib/other.test.ts)"
printf '%s | lib/fixture.test.ts | Reviewed for a different path.\n' "$moved_blob" >>"$moved_repo/scripts/a14-audit.inert-blobs"
git -C "$moved_repo" add .
commit_fixture "$moved_repo" "Add fixture at an unreviewed path"
git -C "$moved_repo" rm -q lib/other.test.ts
commit_fixture "$moved_repo" "Remove it"
expect_failure "reviewed blob at another path" "$moved_repo" ":lib/other.test.ts"

malformed_inert_repo="$fixture_root/malformed-inert"
init_fixture "$malformed_inert_repo"
printf '%s\n' 'not-a-blob | lib/fixture.test.ts | bad entry' >>"$malformed_inert_repo/scripts/a14-audit.inert-blobs"
git -C "$malformed_inert_repo" add .
commit_fixture "$malformed_inert_repo" "Add malformed inert entry"
expect_failure "malformed inert-blob entry" "$malformed_inert_repo" "malformed inert-blob entry"

shapes_repo="$fixture_root/credential-shapes"
init_fixture "$shapes_repo"
mkdir -p "$shapes_repo/config"
key_hex="$(printf 'ab%.0s' {1..32})"
printf '{"privateKey": "0x%s"}\n' "$key_hex" >"$shapes_repo/config/deploy.json"
printf 'Private_Key = "0x%s"\n' "$key_hex" >"$shapes_repo/config/foundry.toml"
printf '%s %s\n' '--private-key' "0x$key_hex" >"$shapes_repo/config/command.txt"
printf 'SIDECAR_AUTH_TOKEN=%s%s\n' 'base64-value-' 'long-enough-for-a-real-hmac-key' >"$shapes_repo/config/service.env.txt"
git -C "$shapes_repo" add .
commit_fixture "$shapes_repo" "Add credential-shape fixtures"
expect_failure "quoted and project-specific credentials" "$shapes_repo" "config/deploy.json"

env_repo="$fixture_root/env-example"
init_fixture "$env_repo"
mkdir -p "$env_repo/sidecar"
# Even an explicit allowlist entry cannot bypass the env-value validation, and a # inside
# quotes is data rather than a comment.
printf '%s\n' 'sidecar/.env.example | Test that env examples remain value-validated.' >>"$env_repo/scripts/a14-audit.allow"
printf 'SIDECAR_AUTH_TOKEN="%s%s"\n' '#' 'not-a-placeholder-value-that-is-long-enough' >"$env_repo/sidecar/.env.example"
git -C "$env_repo" add -f .
commit_fixture "$env_repo" "Populate unsafe env example"
expect_failure "populated env example" "$env_repo" "populated secret value in sidecar/.env.example"

hash_repo="$fixture_root/unquoted-hash-env"
init_fixture "$hash_repo"
mkdir -p "$hash_repo/sidecar"
printf 'BOT_TOKEN=%s%s\n' '#' 'nonempty-bot-token-value-that-must-not-be-a-comment' >"$hash_repo/sidecar/.env.example"
git -C "$hash_repo" add -f .
commit_fixture "$hash_repo" "Add unquoted hash-prefixed secret fixture"
expect_failure "unquoted hash-prefixed env value" "$hash_repo" "variable BOT_TOKEN"

allowlist_repo="$fixture_root/malformed-allowlist"
init_fixture "$allowlist_repo"
mkdir -p "$allowlist_repo/sidecar"
printf '%s\n' 'malformed entry without a justification separator' >>"$allowlist_repo/scripts/a14-audit.allow"
printf 'SIDECAR_AUTH_TOKEN=\n' >"$allowlist_repo/sidecar/.env.example"
git -C "$allowlist_repo" add -f .
commit_fixture "$allowlist_repo" "Add malformed allowlist fixture"
expect_failure "malformed allowlist with only an env example" "$allowlist_repo" "malformed allowlist entry"

merge_repo="$fixture_root/merge-path"
init_fixture "$merge_repo"
git -C "$merge_repo" add .
commit_fixture "$merge_repo" "Base"
initial_branch="$(git -C "$merge_repo" symbolic-ref --short HEAD)"
git -C "$merge_repo" switch -q -c topic
printf 'topic\n' >"$merge_repo/topic.txt"
git -C "$merge_repo" add topic.txt
commit_fixture "$merge_repo" "Topic"
git -C "$merge_repo" switch -q "$initial_branch"
printf 'main\n' >"$merge_repo/main.txt"
git -C "$merge_repo" add main.txt
commit_fixture "$merge_repo" "Main"
git -C "$merge_repo" merge -q --no-commit topic
mkdir -p "$merge_repo/keystores"
printf '\0' >"$merge_repo/keystores/snapfall-deployer"
git -C "$merge_repo" add keystores/snapfall-deployer
commit_fixture "$merge_repo" "Merge topic with keystore path"
expect_failure "merge-only sensitive path" "$merge_repo" "keystores/snapfall-deployer"

error_repo="$fixture_root/git-error"
init_fixture "$error_repo"
git -C "$error_repo" add .
commit_fixture "$error_repo" "Add audit command"
mkdir -p "$error_repo/test-bin"
real_git="$(command -v git)"
printf '%s\n' '#!/bin/sh' \
  'if [ "${A14_TEST_FAIL_GREP:-}" = 1 ] && [ "${1:-}" = grep ]; then' \
  '  echo "injected git grep failure" >&2' \
  '  exit 128' \
  'fi' \
  'exec "$A14_REAL_GIT" "$@"' >"$error_repo/test-bin/git"
chmod +x "$error_repo/test-bin/git"
if error_output="$(cd "$error_repo" && PATH="$error_repo/test-bin:$PATH" A14_REAL_GIT="$real_git" A14_TEST_FAIL_GREP=1 ./scripts/a14-audit 2>&1)"; then
  echo "FAIL: the audit passed after an injected git grep failure"
  failures=$((failures + 1))
elif [[ "$error_output" != *"injected git grep failure"* || "$error_output" != *"ERROR:"* ]]; then
  echo "FAIL: the audit did not surface the injected git failure"
  printf '%s\n' "$error_output"
  failures=$((failures + 1))
fi

shallow_source="$fixture_root/shallow-source"
init_fixture "$shallow_source"
git -C "$shallow_source" add .
commit_fixture "$shallow_source" "First"
printf 'second\n' >"$shallow_source/second.txt"
git -C "$shallow_source" add second.txt
commit_fixture "$shallow_source" "Second"
git clone -q --depth 1 "file://$shallow_source" "$fixture_root/shallow"
expect_failure "shallow history" "$fixture_root/shallow" "refusing an incomplete shallow history"

# The suite must also catch drift between the fixture assumptions and the repository that
# ships the command. This is what detects a future innocent path such as seed_demo making the
# real preflight red while all synthetic cases remain green.
if ! repo_output="$(cd "$repo_root" && ./scripts/a14-audit 2>&1)"; then
  echo "FAIL: the audit does not pass against its own repository"
  printf '%s\n' "$repo_output"
  failures=$((failures + 1))
fi

if ((failures != 0)); then
  exit 1
fi

echo "A14 audit regression tests passed."
