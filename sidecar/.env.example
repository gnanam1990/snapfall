CIRCLE_API_KEY=
# Network: ARC_CHAIN_ID picks it (5042002 Arc testnet, 5042 Arc mainnet). Each network reads ONLY its
# own RPC variable (same names as deployments/arc-*.json); unset falls back to Circle's public endpoint.
ARC_CHAIN_ID=5042002
ARC_TESTNET_RPC=           # e.g. https://arc-testnet.g.alchemy.com/v2/<key>
ARC_MAINNET_RPC=           # e.g. https://arc-mainnet.g.alchemy.com/v2/<key>. Mainnet also needs a seller settlement path, below.

# Seller settlement path (pick at most one; default is Circle Gateway, testnet only):
#   SNAPFALL_CIRCLE_FACILITATOR_SERVICE=1  Circle Facilitator Service, Arc mainnet + testnet. Auth: CIRCLE_API_KEY,
#                                          or SELLER_PRIVATE_KEY (the payTo key) for the keyless trial (exact only).
#   SNAPFALL_SELF_FACILITATOR=1            relay transferWithAuthorization ourselves (BROADCASTER_PRIVATE_KEY pays gas).
SNAPFALL_CIRCLE_FACILITATOR_SERVICE=
SELLER_PRIVATE_KEY=        # keyless trial only; must control SELLER_ADDRESS. Never commit.
ARC_USDC_ADDRESS=          # real Arc-testnet USDC (verifyingContract). Placeholder until confirmed.
SELLER_ADDRESS=            # where the paid demo API is paid; placeholder default is 0x...dEaD
TREASURY_PRIVATE_KEY=      # testnet only. NEVER a funded mainnet key. Never commit .env.
PAID_API_PORT=4021
SIDECAR_PORT=4020

# H3 payment sidecar (V4) — see docs/handshakes/H3-sidecar-api.md
SIDECAR_AUTH_TOKEN=        # >=32-byte secret; the Funding agent + sidecar only. Bearer auth. Never commit.
H2_APPROVAL_SECRET=        # shared with Gnanam's approval service; HMAC key for approvalToken. Never commit.
SIDECAR_STORE_PATH=        # optional; durable payment record file (default .data/payments.json)
